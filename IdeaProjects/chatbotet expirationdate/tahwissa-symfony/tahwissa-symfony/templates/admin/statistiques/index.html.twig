{% extends 'admin/layout.html.twig' %}
{% block title %}Admin - Statistiques{% endblock %}

{% block stylesheets %}
<style>
    .stats-page-header {
        margin-bottom: 28px;
    }
    .stats-page-header h1 {
        font-size: 1.6rem;
        font-weight: 800;
        color: var(--text-dark);
        margin-bottom: 4px;
    }
    .stats-page-header p {
        color: var(--text-muted);
        font-size: 0.88rem;
    }

    /* KPI Grid */
    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 16px;
        margin-bottom: 28px;
    }
    .kpi-card {
        background: white;
        border-radius: 14px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 14px;
        box-shadow: 0 1px 6px rgba(0,0,0,0.05);
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .kpi-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 6px 20px rgba(0,0,0,0.1);
    }
    .kpi-icon {
        width: 46px; height: 46px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        flex-shrink: 0;
    }
    .kpi-icon.blue   { background: rgba(21,101,192,0.1);  color: var(--primary); }
    .kpi-icon.green  { background: rgba(0,200,83,0.1);    color: var(--success); }
    .kpi-icon.orange { background: rgba(255,109,0,0.1);   color: var(--accent); }
    .kpi-icon.purple { background: rgba(124,77,255,0.1);  color: var(--secondary); }
    .kpi-icon.red    { background: rgba(255,23,68,0.1);   color: var(--danger); }
    .kpi-icon.cyan   { background: rgba(0,176,255,0.1);   color: var(--info); }
    .kpi-val  { font-size: 1.5rem; font-weight: 800; line-height: 1.1; color: var(--text-dark); }
    .kpi-label { font-size: 0.78rem; color: var(--text-muted); margin-top: 2px; }

    /* Chart cards */
    .chart-grid {
        display: grid;
        gap: 20px;
        margin-bottom: 28px;
    }
    .chart-grid.cols-2-1 { grid-template-columns: 2fr 1fr; }
    .chart-grid.cols-1-1 { grid-template-columns: 1fr 1fr; }
    .chart-card {
        background: white;
        border-radius: 14px;
        padding: 24px;
        box-shadow: 0 1px 6px rgba(0,0,0,0.05);
    }
    .chart-card h3 {
        font-size: 0.95rem;
        font-weight: 700;
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--text-dark);
    }
    .chart-card h3 i { font-size: 0.9rem; }
    .chart-wrap { position: relative; height: 260px; }

    /* Top destinations */
    .dest-list { display: flex; flex-direction: column; gap: 10px; }
    .dest-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 12px;
        background: #f8fafc;
        border-radius: 10px;
        transition: background 0.2s;
    }
    .dest-item:hover { background: #eef3f9; }
    .dest-rank {
        width: 30px; height: 30px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--primary), var(--secondary));
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: 800;
        font-size: 0.75rem;
        flex-shrink: 0;
    }
    .dest-name { font-weight: 600; font-size: 0.9rem; }
    .dest-count { font-size: 0.75rem; color: var(--text-muted); }
    .dest-revenue { font-weight: 700; color: var(--accent); font-size: 0.88rem; margin-left: auto; }

    @media (max-width: 900px) {
        .chart-grid.cols-2-1, .chart-grid.cols-1-1 { grid-template-columns: 1fr; }
        .kpi-grid { grid-template-columns: repeat(2, 1fr); }
    }
</style>
{% endblock %}

{% block content %}
<div class="stats-page-header">
    <h1><i class="fas fa-chart-line" style="color:var(--accent);margin-right:8px;"></i> Tableau de Bord</h1>
    <p>Vue d'ensemble de l'activité Tahwissa</p>
</div>

{# KPI row #}
<div class="kpi-grid">
    <div class="kpi-card">
        <div class="kpi-icon blue"><i class="fas fa-plane"></i></div>
        <div><div class="kpi-val">{{ voyageStats.total }}</div><div class="kpi-label">Voyages</div></div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon green"><i class="fas fa-ticket-alt"></i></div>
        <div><div class="kpi-val">{{ reservationStats.total }}</div><div class="kpi-label">Réservations</div></div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon orange"><i class="fas fa-coins"></i></div>
        <div><div class="kpi-val">{{ reservationStats.revenu|number_format(0, ',', ' ') }}</div><div class="kpi-label">Revenu (TND)</div></div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon purple"><i class="fas fa-users"></i></div>
        <div><div class="kpi-val">{{ totalUsers }}</div><div class="kpi-label">Utilisateurs</div></div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon green"><i class="fas fa-check-circle"></i></div>
        <div><div class="kpi-val">{{ reservationStats.confirmees }}</div><div class="kpi-label">Confirmées</div></div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon orange"><i class="fas fa-clock"></i></div>
        <div><div class="kpi-val">{{ reservationStats.enAttente }}</div><div class="kpi-label">En attente</div></div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon red"><i class="fas fa-times-circle"></i></div>
        <div><div class="kpi-val">{{ reservationStats.annulees }}</div><div class="kpi-label">Annulées</div></div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon cyan"><i class="fas fa-calendar-alt"></i></div>
        <div><div class="kpi-val">{{ totalEvenements }}</div><div class="kpi-label">Événements</div></div>
    </div>
</div>

{# Charts: Monthly + Status #}
<div class="chart-grid cols-2-1">
    <div class="chart-card">
        <h3><i class="fas fa-chart-bar" style="color:var(--primary);"></i> Réservations Mensuelles</h3>
        <div class="chart-wrap"><canvas id="monthlyChart"></canvas></div>
    </div>
    <div class="chart-card">
        <h3><i class="fas fa-chart-pie" style="color:var(--secondary);"></i> Par Statut</h3>
        <div class="chart-wrap"><canvas id="statusChart"></canvas></div>
    </div>
</div>

{# Charts: Revenue + Top Destinations #}
<div class="chart-grid cols-2-1">
    <div class="chart-card">
        <h3><i class="fas fa-money-bill-wave" style="color:var(--success);"></i> Revenu Mensuel (TND)</h3>
        <div class="chart-wrap"><canvas id="revenueChart"></canvas></div>
    </div>
    <div class="chart-card">
        <h3><i class="fas fa-trophy" style="color:var(--accent);"></i> Top Destinations</h3>
        {% if topDestinations is empty %}
            <div style="text-align:center;padding:40px;color:var(--text-muted);">
                <i class="fas fa-map-marked-alt" style="font-size:2rem;opacity:0.3;display:block;margin-bottom:8px;"></i>
                Aucune donnée
            </div>
        {% else %}
            <div class="dest-list">
                {% for dest in topDestinations %}
                <div class="dest-item">
                    <div class="dest-rank">{{ loop.index }}</div>
                    <div>
                        <div class="dest-name">{{ dest.destination }}</div>
                        <div class="dest-count">{{ dest.total }} réservation{{ dest.total > 1 ? 's' : '' }}</div>
                    </div>
                    <div class="dest-revenue">{{ dest.revenu|number_format(0, ',', ' ') }} TND</div>
                </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.6/dist/chart.umd.min.js"></script>
<script>
    const monthLabels = {{ monthlyData|map(d => d.mois)|json_encode|raw }};
    const monthTotals = {{ monthlyData|map(d => d.total)|json_encode|raw }};
    const monthRevenu = {{ monthlyData|map(d => d.revenu)|json_encode|raw }};

    // Monthly reservations bar chart
    new Chart(document.getElementById('monthlyChart'), {
        type: 'bar',
        data: {
            labels: monthLabels,
            datasets: [{
                label: 'Réservations',
                data: monthTotals,
                backgroundColor: 'rgba(21,101,192,0.7)',
                borderRadius: 8,
                borderSkipped: false,
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                y: { beginAtZero: true, ticks: { stepSize: 1 } },
                x: { grid: { display: false } }
            }
        }
    });

    // Status pie chart
    const statusLabels = {{ statusData|map(d => d.statut)|json_encode|raw }};
    const statusTotals = {{ statusData|map(d => d.total)|json_encode|raw }};
    const statusColors = statusLabels.map(s => {
        switch(s) {
            case 'EN_ATTENTE': return '#F9A825';
            case 'CONFIRMEE': return '#00C853';
            case 'ANNULEE': return '#FF1744';
            case 'TERMINEE': return '#00B0FF';
            default: return '#94a3b8';
        }
    });

    new Chart(document.getElementById('statusChart'), {
        type: 'doughnut',
        data: {
            labels: statusLabels.map(s => {
                switch(s) {
                    case 'EN_ATTENTE': return 'En attente';
                    case 'CONFIRMEE': return 'Confirmée';
                    case 'ANNULEE': return 'Annulée';
                    case 'TERMINEE': return 'Terminée';
                    default: return s;
                }
            }),
            datasets: [{
                data: statusTotals,
                backgroundColor: statusColors,
                borderWidth: 0,
                spacing: 2,
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: '60%',
            plugins: {
                legend: { position: 'bottom', labels: { padding: 16, font: { size: 12 } } }
            }
        }
    });

    // Revenue line chart
    new Chart(document.getElementById('revenueChart'), {
        type: 'line',
        data: {
            labels: monthLabels,
            datasets: [{
                label: 'Revenu (TND)',
                data: monthRevenu,
                borderColor: '#00C853',
                backgroundColor: 'rgba(0,200,83,0.1)',
                fill: true,
                tension: 0.4,
                pointRadius: 5,
                pointBackgroundColor: '#00C853',
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                y: { beginAtZero: true },
                x: { grid: { display: false } }
            }
        }
    });
</script>
{% endblock %}
