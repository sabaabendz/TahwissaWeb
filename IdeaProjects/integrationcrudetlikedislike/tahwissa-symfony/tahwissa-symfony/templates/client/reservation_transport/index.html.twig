{% extends 'client/layout.html.twig' %}

{% block title %}Mes Réservations (Transport){% endblock %}

{% block content %}
<div class="top-bar" style="margin-bottom: 24px;">
    <div>
        <h1><i class="fas fa-ticket-alt" style="color:var(--accent);margin-right:10px;"></i>Mes Réservations de Transport</h1>
        <p style="color:var(--text-muted);font-size:0.9rem;">Historique et suivi de vos itinéraires</p>
    </div>
    <div class="top-bar-right">
        <a href="{{ path('client_transport_index') }}" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> Nouvelle Réservation</a>
    </div>
</div>

<div class="dashboard-card">
    <table class="data-table">
        <thead>
            <tr>
                <th>#</th>
                <th>Transport</th>
                <th>Départ <i class="fas fa-arrow-right" style="font-size:0.7em;"></i> Arrivée</th>
                <th>Date Réserv.</th>
                <th>Voyageurs</th>
                <th>Montant Total</th>
                <th>Statut</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for r in reservations %}
            <tr>
                <td style="font-weight:600;color:var(--text-muted);">#R{{ '%03d'|format(r.idReservation) }}</td>
                <td>
                    <i class="fas fa-bus" style="color:var(--secondary);margin-right:4px;"></i>{{ r.transport.typeTransport }}
                </td>
                <td>
                    <span style="font-weight:500;">{{ r.transport.villeDepart }}</span> 
                    <i class="fas fa-arrow-right" style="color:var(--text-muted);font-size:0.8rem;margin:0 4px;"></i> 
                    <span style="font-weight:500;">{{ r.transport.villeArrivee }}</span>
                </td>
                <td>{{ r.dateReservation|date('d/m/Y') }}</td>
                <td>{{ r.nbPlacesReservees }} pers.</td>
                <td style="font-weight:700;">{{ (r.nbPlacesReservees * r.transport.prix)|number_format(2) }} TND</td>
                <td>
                    {% if r.statut == 'CONFIRMEE' %}<span class="badge badge-success">Confirmée</span>
                    {% elseif r.statut == 'EN_ATTENTE' %}<span class="badge badge-warning">En attente</span>
                    {% elseif r.statut == 'ANNULEE' %}<span class="badge badge-danger">Annulée</span>
                    {% else %}<span class="badge badge-info">{{ r.statut }}</span>
                    {% endif %}
                </td>
                <td>
                    {% if r.statut == 'EN_ATTENTE' %}
                    <form method="post" action="{{ path('client_reservation_transport_cancel', {'id': r.idReservation}) }}" style="display:inline;" onsubmit="return confirm('Voulez-vous vraiment annuler cette réservation ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('cancel' ~ r.idReservation) }}">
                        <button type="submit" class="action-btn delete" title="Annuler" style="color:var(--danger); border:1px solid rgba(255,23,68,0.2);"><i class="fas fa-times-circle"></i></button>
                    </form>
                    {% endif %}
                </td>
            </tr>
            {% else %}
            <tr><td colspan="8" style="text-align:center;color:#94a3b8;padding:20px;">Vous n'avez pas encore effectué de réservation de transport.</td></tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
