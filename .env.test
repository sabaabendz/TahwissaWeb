APP_ENV=test
APP_DEBUG=0
APP_SECRET=test_secret_key_for_testing_only

# Database Configuration - Using SQLite in-memory for fast tests
DATABASE_URL="sqlite:///:memory:"

# Mailer Configuration - Disabled during tests
MAILER_DSN=null://default

# External Services - Test Configuration
KNPU_OAUTH2_CLIENT_GITHUB_ID=test_github_id
KNPU_OAUTH2_CLIENT_GITHUB_SECRET=test_github_secret
UNSPLASH_API_KEY=test_key
