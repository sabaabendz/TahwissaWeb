{# ═══ CHATBOT IA WIDGET ═══ #}
{# ══════════════════════════════════════════════════════════ #}

<style>
/* ── Chatbot Toggle Button ── */
.chatbot-toggle {
    position: fixed; bottom: 28px; right: 28px; z-index: 9999;
    width: 62px; height: 62px; border-radius: 50%;
    background: linear-gradient(135deg, #667eea, #764ba2);
    border: none; cursor: pointer; color: white; font-size: 1.6rem;
    box-shadow: 0 6px 25px rgba(102, 126, 234, 0.45);
    transition: all 0.3s ease; display: flex; align-items: center; justify-content: center;
}
.chatbot-toggle:hover { transform: scale(1.1); box-shadow: 0 8px 35px rgba(102, 126, 234, 0.6); }
.chatbot-toggle.active { background: linear-gradient(135deg, #e74c3c, #c0392b); }
.chatbot-toggle .badge-notif {
    position: absolute; top: -2px; right: -2px;
    width: 18px; height: 18px; background: #e74c3c; border-radius: 50%;
    font-size: 0.65rem; display: flex; align-items: center; justify-content: center;
    animation: pulse-notif 2s infinite;
}
@keyframes pulse-notif { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.2); } }

/* ── Chat Window ── */
.chatbot-window {
    position: fixed; bottom: 100px; right: 28px; z-index: 9998;
    width: 400px; max-height: 550px;
    background: white; border-radius: 20px;
    box-shadow: 0 12px 50px rgba(0,0,0,0.15);
    display: none; flex-direction: column; overflow: hidden;
    animation: slideUp 0.3s ease;
}
.chatbot-window.open { display: flex; }
@keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

/* Header */
.chatbot-header {
    background: linear-gradient(135deg, #667eea, #764ba2);
    padding: 16px 20px; color: white; display: flex; align-items: center; gap: 12px;
}
.chatbot-header .avatar {
    width: 42px; height: 42px; border-radius: 50%; background: rgba(255,255,255,0.2);
    display: flex; align-items: center; justify-content: center; font-size: 1.3rem;
}
.chatbot-header h4 { margin: 0; font-size: 1rem; font-weight: 700; }
.chatbot-header p { margin: 0; font-size: 0.75rem; opacity: 0.85; }

/* Messages */
.chatbot-messages {
    flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 12px;
    max-height: 340px; scroll-behavior: smooth;
}
.chat-msg {
    max-width: 85%; padding: 10px 14px; border-radius: 16px;
    font-size: 0.85rem; line-height: 1.5; word-wrap: break-word;
}
.chat-msg.bot {
    background: #f1f3f5; color: #2d3436; align-self: flex-start;
    border-bottom-left-radius: 4px;
}
.chat-msg.user {
    background: linear-gradient(135deg, #667eea, #764ba2); color: white; align-self: flex-end;
    border-bottom-right-radius: 4px;
}
.chat-msg.bot .voyage-card-mini {
    background: white; border-radius: 10px; padding: 10px; margin-top: 8px;
    border: 1px solid #e2e8f0; cursor: pointer; transition: all 0.2s;
}
.chat-msg.bot .voyage-card-mini:hover { border-color: #667eea; box-shadow: 0 2px 8px rgba(102,126,234,0.15); }

.typing-indicator { display: flex; gap: 4px; align-self: flex-start; padding: 12px 16px; }
.typing-indicator span {
    width: 8px; height: 8px; background: #b2bec3; border-radius: 50%;
    animation: typingBounce 1.4s infinite;
}
.typing-indicator span:nth-child(2) { animation-delay: 0.2s; }
.typing-indicator span:nth-child(3) { animation-delay: 0.4s; }
@keyframes typingBounce { 0%, 60%, 100% { transform: translateY(0); } 30% { transform: translateY(-8px); } }

/* Input */
.chatbot-input {
    padding: 12px 16px; border-top: 1px solid #f1f3f5; display: flex; gap: 8px; align-items: center;
}
.chatbot-input input {
    flex: 1; border: 2px solid #e2e8f0; border-radius: 50px; padding: 10px 16px;
    font-size: 0.85rem; outline: none; transition: border-color 0.2s;
}
.chatbot-input input:focus { border-color: #667eea; }
.chatbot-input button {
    width: 40px; height: 40px; border-radius: 50%; border: none;
    background: linear-gradient(135deg, #667eea, #764ba2); color: white;
    cursor: pointer; display: flex; align-items: center; justify-content: center;
    transition: transform 0.2s;
}
.chatbot-input button:hover { transform: scale(1.1); }
.chatbot-input button:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }

/* Quick suggestions */
.quick-suggestions {
    display: flex; flex-wrap: wrap; gap: 6px; padding: 0 16px 12px;
}
.quick-suggestions button {
    background: #f1f3f5; border: 1px solid #e2e8f0; border-radius: 50px;
    padding: 5px 12px; font-size: 0.75rem; cursor: pointer; transition: all 0.2s;
    color: #636e72;
}
.quick-suggestions button:hover { background: #667eea; color: white; border-color: #667eea; }

/* Dark mode */
body.dark .chatbot-window { background: #1e293b; }
body.dark .chat-msg.bot { background: #334155; color: #e2e8f0; }
body.dark .chatbot-input { border-top-color: #334155; }
body.dark .chatbot-input input { background: #0f172a; color: #e2e8f0; border-color: #334155; }
body.dark .chatbot-input input:focus { border-color: #667eea; }
body.dark .quick-suggestions button { background: #334155; color: #94a3b8; border-color: #475569; }
body.dark .chat-msg.bot .voyage-card-mini { background: #0f172a; border-color: #475569; color: #e2e8f0; }
</style>

<!-- Chatbot Toggle Button -->
<button class="chatbot-toggle" id="chatbot-toggle" onclick="toggleChatbot()" title="Tahwissa AI Assistant">
    <span id="chatbot-icon">🤖</span>
    <span class="badge-notif" id="chatbot-notif" style="display:none;"></span>
</button>

<!-- Chatbot Window -->
<div class="chatbot-window" id="chatbot-window">
    <div class="chatbot-header">
        <div class="avatar">🌍</div>
        <div>
            <h4>Tahwissa AI</h4>
            <p>Votre assistant voyage intelligent</p>
        </div>
    </div>

    <div class="chatbot-messages" id="chatbot-messages">
        <div class="chat-msg bot">
            Bonjour ! 👋 Je suis <strong>Tahwissa AI</strong>, votre assistant de voyage.
            <br><br>Comment puis-je vous aider ? Dites-moi votre destination rêvée, votre budget, ou posez-moi une question ! 🌍✈️
        </div>
    </div>

    <div class="quick-suggestions" id="quick-suggestions">
        <button onclick="sendQuickMessage(this)">🏖️ Voyages balnéaires</button>
        <button onclick="sendQuickMessage(this)">💰 Voyages pas chers</button>
        <button onclick="sendQuickMessage(this)">🏔️ Aventure nature</button>
        <button onclick="sendQuickMessage(this)">👨‍👩‍👧‍👦 Voyage en famille</button>
        <button onclick="sendQuickMessage(this)">📅 Prochains départs</button>
    </div>

    <div class="chatbot-input">
        <input type="text" id="chatbot-input" placeholder="Écrivez votre message..."
               onkeypress="if(event.key==='Enter') sendChatMessage()">
        <button id="chatbot-send" onclick="sendChatMessage()">
            <i class="fas fa-paper-plane"></i>
        </button>
    </div>
</div>

<script>
(function() {
    const CHATBOT_URL = '{{ path("client_chatbot_send") }}';
    let chatHistory = [];
    let isOpen = false;
    let isFirstOpen = true;

    window.toggleChatbot = function() {
        const win = document.getElementById('chatbot-window');
        const toggle = document.getElementById('chatbot-toggle');
        const icon = document.getElementById('chatbot-icon');
        isOpen = !isOpen;
        win.classList.toggle('open', isOpen);
        toggle.classList.toggle('active', isOpen);
        icon.textContent = isOpen ? '✕' : '🤖';
        document.getElementById('chatbot-notif').style.display = 'none';
        if (isOpen) {
            document.getElementById('chatbot-input').focus();
        }
    };

    window.sendQuickMessage = function(btn) {
        const text = btn.textContent.trim();
        document.getElementById('chatbot-input').value = text;
        sendChatMessage();
        // Hide suggestions after first use
        document.getElementById('quick-suggestions').style.display = 'none';
    };

    window.sendChatMessage = function() {
        const input = document.getElementById('chatbot-input');
        const message = input.value.trim();
        if (!message) return;

        // Add user message to UI
        addMessage(message, 'user');
        input.value = '';
        input.disabled = true;
        document.getElementById('chatbot-send').disabled = true;

        // Show typing indicator
        const typing = showTyping();

        // Send to backend
        fetch(CHATBOT_URL, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest',
            },
            body: JSON.stringify({
                message: message,
                history: chatHistory,
            }),
        })
        .then(r => r.json())
        .then(data => {
            removeTyping(typing);
            input.disabled = false;
            document.getElementById('chatbot-send').disabled = false;
            input.focus();

            // Add to history
            chatHistory.push({ role: 'user', content: message });
            chatHistory.push({ role: 'assistant', content: data.reply });

            // Keep history manageable
            if (chatHistory.length > 20) {
                chatHistory = chatHistory.slice(-16);
            }

            // Add bot reply
            addMessage(data.reply, 'bot', data.voyages || []);
        })
        .catch(err => {
            removeTyping(typing);
            input.disabled = false;
            document.getElementById('chatbot-send').disabled = false;
            addMessage('❌ Erreur de connexion. Vérifiez que votre clé API OpenAI est configurée dans le fichier .env', 'bot');
        });
    };

    function addMessage(text, type, voyages) {
        const container = document.getElementById('chatbot-messages');
        const msg = document.createElement('div');
        msg.classList.add('chat-msg', type);

        if (type === 'bot') {
            // Convert markdown-like formatting
            let html = text
                .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
                .replace(/\n/g, '<br>');
            msg.innerHTML = html;

            // Add voyage recommendation cards
            if (voyages && voyages.length > 0) {
                voyages.forEach(v => {
                    const card = document.createElement('div');
                    card.className = 'voyage-card-mini';
                    card.innerHTML = `
                        <div style="display:flex;justify-content:space-between;align-items:center;">
                            <div>
                                <strong style="font-size:0.85rem;">✈️ ${v.titre}</strong><br>
                                <span style="font-size:0.75rem;color:#636e72;">📍 ${v.destination} | 📅 ${v.dateDepart || '?'} → ${v.dateRetour || '?'}</span>
                            </div>
                            <div style="text-align:right;">
                                <div style="font-weight:800;color:#667eea;font-size:0.9rem;">${parseFloat(v.prix).toFixed(0)} TND</div>
                                <div style="font-size:0.7rem;color:#636e72;">${v.places} places</div>
                            </div>
                        </div>
                    `;
                    card.onclick = function() {
                        window.location.href = '/client/reservation/new/' + v.id;
                    };
                    msg.appendChild(card);
                });
            }
        } else {
            msg.textContent = text;
        }

        container.appendChild(msg);
        container.scrollTop = container.scrollHeight;
    }

    function showTyping() {
        const container = document.getElementById('chatbot-messages');
        const typing = document.createElement('div');
        typing.className = 'typing-indicator';
        typing.id = 'typing-indicator';
        typing.innerHTML = '<span></span><span></span><span></span>';
        container.appendChild(typing);
        container.scrollTop = container.scrollHeight;
        return typing;
    }

    function removeTyping(el) {
        if (el && el.parentNode) el.parentNode.removeChild(el);
    }

    // Show notification badge after 5 seconds if chat not opened
    setTimeout(function() {
        if (!isOpen) {
            document.getElementById('chatbot-notif').style.display = 'flex';
        }
    }, 5000);
})();
</script>
{% endblock %}
