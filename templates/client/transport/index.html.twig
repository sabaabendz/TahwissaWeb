{% extends 'client/layout.html.twig' %}

{% block title %}Nos Transports{% endblock %}

{% block content %}
<style>
  .hero-section {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 40px 20px;
    border-radius: 12px;
    margin-bottom: 40px;
    text-align: center;
  }

  .hero-title {
    font-size: 2.2rem;
    font-weight: 700;
    margin: 0 0 10px 0;
  }

  .hero-subtitle {
    font-size: 1.1rem;
    opacity: 0.9;
    margin: 0;
  }

  .transport-card {
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .transport-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 32px rgba(0,0,0,0.15);
  }

  .transport-image {
    width: 100%;
    height: 200px;
    object-fit: cover;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  }

  .transport-content {
    padding: 18px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .transport-header {
    display: flex;
    align-items: center;
    margin-bottom: 12px;
    gap: 10px;
  }

  .transport-type-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    color: white;
    font-size: 1.2rem;
    flex-shrink: 0;
  }

  .type-bus { background: linear-gradient(135deg, #42A5F5, #1565C0); }
  .type-minibus { background: linear-gradient(135deg, #7C4DFF, #B388FF); }
  .type-taxi { background: linear-gradient(135deg, #FFC107, #FF9800); }
  .type-default { background: linear-gradient(135deg, #666, #999); }

  .transport-title {
    flex: 1;
  }

  .transport-title h3 {
    font-size: 1.05rem;
    font-weight: 700;
    margin: 0;
    color: #1a1a1a;
  }

  .transport-title p {
    font-size: 0.8rem;
    color: #888;
    margin: 4px 0 0 0;
  }

  .transport-route {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #666;
    font-size: 0.95rem;
    margin-bottom: 14px;
    padding-bottom: 14px;
    border-bottom: 1px solid #f0f0f0;
  }

  .route-item {
    display: flex;
    align-items: center;
    gap: 4px;
    flex: 1;
  }

  .route-arrow {
    color: #999;
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  .transport-info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 16px;
    font-size: 0.9rem;
  }

  .info-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px;
    background: #f8f8f8;
    border-radius: 8px;
  }

  .info-item i {
    width: 18px;
    color: #667eea;
    text-align: center;
    font-size: 0.95rem;
  }

  .info-label {
    font-size: 0.75rem;
    color: #999;
  }

  .info-value {
    font-weight: 700;
    color: #222;
    font-size: 1rem;
  }

  .price-section {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid #f0f0f0;
  }

  .price {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .price-label {
    font-size: 0.75rem;
    color: #999;
  }

  .price-value {
    font-size: 1.4rem;
    font-weight: 700;
    color: #667eea;
  }

  .price-currency {
    font-size: 0.8rem;
    color: #999;
    margin-left: 2px;
  }

  .reserve-btn {
    flex: 1;
    margin-left: 12px;
    padding: 10px 16px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    border: none;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    transition: all 0.3s;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }

  .reserve-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 16px rgba(102, 126, 234, 0.4);
  }

  .transport-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 24px;
    margin-bottom: 40px;
  }

  .empty-state {
    text-align: center;
    padding: 60px 20px;
    background: white;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
  }

  .empty-icon {
    font-size: 3rem;
    color: #ccc;
    margin-bottom: 16px;
  }

  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin-top: 40px;
    flex-wrap: wrap;
  }

  .pagination a, .pagination span {
    padding: 8px 12px;
    border-radius: 6px;
    border: 1px solid #ddd;
    background: white;
    color: #667eea;
    text-decoration: none;
    transition: all 0.2s;
    cursor: pointer;
  }

  .pagination a:hover {
    background: #667eea;
    color: white;
    border-color: #667eea;
  }

  .pagination span {
    background: #667eea;
    color: white;
    border-color: #667eea;
  }

  @media (max-width: 768px) {
    .transport-grid {
      grid-template-columns: 1fr;
    }

    .transport-info-grid {
      grid-template-columns: 1fr;
    }

    .hero-title {
      font-size: 1.8rem;
    }

    .price-section {
      flex-direction: column;
      gap: 12px;
    }

    .reserve-btn {
      margin-left: 0;
      width: 100%;
    }
  }
</style>

<!-- Hero Section -->
<div class="hero-section">
  <h1 class="hero-title">Découvrez Nos Transports</h1>
  <p class="hero-subtitle">Réservez votre transport idéal pour vos voyages</p>
</div>

<!-- Transport Cards Grid -->
{% if transports|length > 0 %}
<div class="transport-grid">
  {% for transport in transports %}
  <div class="transport-card">
    <!-- Image Section -->
    {% if transportImages[transport.getIdTransport()] %}
      <img src="{{ transportImages[transport.getIdTransport()] }}" alt="{{ transport.typeTransport }}" class="transport-image" loading="lazy">
    {% else %}
      <div class="transport-image"></div>
    {% endif %}

    <!-- Content Section -->
    <div class="transport-content">
      <!-- Header with type -->
      <div class="transport-header">
        {% set typeClass = transport.typeTransport == 'Bus' ? 'type-bus' : (transport.typeTransport == 'Taxi' ? 'type-taxi' : (transport.typeTransport == 'Minibus' ? 'type-minibus' : 'type-default')) %}
        {% set icon = transport.typeTransport == 'Bus' ? 'fas fa-bus' : (transport.typeTransport == 'Taxi' ? 'fas fa-taxi' : 'fas fa-shuttle-van') %}
        <div class="transport-type-badge {{ typeClass }}">
          <i class="{{ icon }}"></i>
        </div>
        <div class="transport-title">
          <h3>{{ transport.typeTransport }}</h3>
          <p>{{ transport.villeDepart }} → {{ transport.villeArrivee }}</p>
        </div>
      </div>

      <!-- Route -->
      <div class="transport-route">
        <div class="route-item">
          <i class="fas fa-map-marker-alt" style="color: #667eea;"></i>
          <span>{{ transport.villeDepart|default('Départ') }}</span>
        </div>
        <div class="route-arrow">→</div>
        <div class="route-item">
          <i class="fas fa-flag-checkered" style="color: #667eea;"></i>
          <span>{{ transport.villeArrivee|default('Arrivée') }}</span>
        </div>
      </div>

      <!-- Info Grid -->
      <div class="transport-info-grid">
        <div class="info-item">
          <i class="fas fa-users"></i>
          <div>
            <div class="info-label">Places</div>
            <div class="info-value">{{ transport.nbPlaces }}</div>
          </div>
        </div>
        <div class="info-item">
          <i class="fas fa-clock"></i>
          <div>
            <div class="info-label">Durée</div>
            <div class="info-value">{{ transport.duree|default('-') }}h</div>
          </div>
        </div>
        <div class="info-item">
          <i class="fas fa-calendar"></i>
          <div>
            <div class="info-label">Date</div>
            <div class="info-value">{{ transport.dateDepart|date('d/m')|default('-') }}</div>
          </div>
        </div>
      </div>

      <!-- Price & Reserve Section -->
      <div class="price-section">
        <div class="price">
          <span class="price-label">À partir de</span>
          <div>
            <span class="price-value">{{ (currencyService.convertPrice(transport.prix))|number_format(2, '.', ',') }}</span>
            <span class="price-currency">{{ currencyService.getCurrencySymbol() }}</span>
          </div>
          {% if currencyService.getUserCurrency() != 'TND' %}
            <small style="color: #999; font-size: 0.8rem; margin-top: 4px;">
              ({{ transport.prix|number_format(2, '.', ',') }} TND)
            </small>
          {% endif %}
        </div>
        <a href="{{ path('client_reservation_transport_new', {'transportId': transport.getIdTransport()}) }}" class="reserve-btn">
          <i class="fas fa-calendar-check"></i> Réserver
        </a>
      </div>
    </div>
  </div>
  {% endfor %}
</div>

{% else %}
<div class="empty-state">
  <div class="empty-icon">
    <i class="fas fa-inbox"></i>
  </div>
  <h3 style="font-size:1.2rem;margin-bottom:8px;color:#1a1a1a;">Aucun transport disponible</h3>
  <p style="color: #888;">Veuillez revenir plus tard pour découvrir nos transports.</p>
</div>
{% endif %}

<!-- Pagination -->
{% if transports.pageCount > 1 %}
<div class="pagination">
  <a href="{{ path('client_transport_index', {'page': 1}) }}" title="Première page">
    <i class="fas fa-angle-double-left"></i>
  </a>
  
  {% if transports.currentPageNumber > 1 %}
  <a href="{{ path('client_transport_index', {'page': transports.currentPageNumber - 1}) }}" title="Page précédente">
    <i class="fas fa-angle-left"></i>
  </a>
  {% else %}
  <span style="opacity:0.5;cursor:not-allowed;">
    <i class="fas fa-angle-left"></i>
  </span>
  {% endif %}

  {% for page in 1..transports.pageCount %}
    {% if page == transports.currentPageNumber %}
      <span>{{ page }}</span>
    {% elseif page >= transports.currentPageNumber - 2 and page <= transports.currentPageNumber + 2 %}
      <a href="{{ path('client_transport_index', {'page': page}) }}">{{ page }}</a>
    {% endif %}
  {% endfor %}

  {% if transports.currentPageNumber < transports.pageCount %}
  <a href="{{ path('client_transport_index', {'page': transports.currentPageNumber + 1}) }}" title="Page suivante">
    <i class="fas fa-angle-right"></i>
  </a>
  {% else %}
  <span style="opacity:0.5;cursor:not-allowed;">
    <i class="fas fa-angle-right"></i>
  </span>
  {% endif %}

  <a href="{{ path('client_transport_index', {'page': transports.pageCount}) }}" title="Dernière page">
    <i class="fas fa-angle-double-right"></i>
  </a>
</div>
{% endif %}

{% endblock %}
