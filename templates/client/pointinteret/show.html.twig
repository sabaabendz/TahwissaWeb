{% extends 'client/layout.html.twig' %}
{% block title %}{{ pointInteret.nom }}{% endblock %}

{% block content %}
<div style="margin-bottom:16px;">
    <a href="{{ path('client_pointinteret_index') }}" style="color:var(--primary);text-decoration:none;font-size:0.9rem;font-weight:500;">
        <i class="fas fa-arrow-left"></i> Retour aux points d'intérêt
    </a>
</div>

<div class="detail-card">
    <div class="detail-header">
        <div>
            <h2 style="font-size:1.8rem;font-weight:800;margin-bottom:10px;">
                <i class="fas fa-{{ pointInteret.type == 'monument' ? 'landmark' : pointInteret.type == 'plage' ? 'umbrella-beach' : pointInteret.type == 'musée' ? 'museum' : 'tag' }}" style="color:var(--primary);"></i> {{ pointInteret.nom }}
            </h2>
            <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
                <span class="badge badge-primary">{{ pointInteret.type|capitalize }}</span>
                <span class="badge badge-purple"><i class="fas fa-map-marker-alt"></i> {{ pointInteret.destination.nom }}</span>
                <span class="badge badge-info"><i class="fas fa-flag"></i> {{ pointInteret.destination.pays }}</span>
            </div>
        </div>
    </div>

    {% if pointInteret.description %}
    <div style="margin-bottom:28px;padding:20px;background:#f8fafc;border-radius:var(--radius-sm);border-left:4px solid var(--primary);color:#475569;font-size:0.95rem;line-height:1.8;">
        {{ pointInteret.description }}
    </div>
    {% endif %}

    <div class="detail-grid">
        <div class="detail-item">
            <div class="label"><i class="fas fa-tag"></i> Type</div>
            <div class="value">{{ pointInteret.type|capitalize }}</div>
        </div>
        <div class="detail-item">
            <div class="label"><i class="fas fa-map-marker-alt"></i> Destination</div>
            <div class="value">
                <a href="{{ path('client_destination_show', {id: pointInteret.destination.idDestination}) }}" style="color:var(--primary);text-decoration:none;">
                    {{ pointInteret.destination.nom }}
                </a>
            </div>
        </div>
        <div class="detail-item">
            <div class="label"><i class="fas fa-flag"></i> Pays</div>
            <div class="value">{{ pointInteret.destination.pays }}</div>
        </div>
    </div>

    <div style="margin-top:32px;text-align:center;">
        <a href="{{ path('client_destination_show', {id: pointInteret.destination.idDestination}) }}" class="btn btn-primary" style="font-size:1rem;padding:14px 40px;">
            <i class="fas fa-map-marker-alt"></i> Découvrir la destination {{ pointInteret.destination.nom }}
        </a>
    </div>
</div>
{% endblock %}