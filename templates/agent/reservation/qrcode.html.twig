{% extends 'agent/layout.html.twig' %}
{% block title %}QR Code — Réservation #{{ reservation.id }}{% endblock %}

{% block content %}
<div class="top-bar">
    <div><h1><i class="fas fa-qrcode" style="color:#8e44ad;margin-right:10px;"></i>QR Code — Réservation #{{ reservation.id }}</h1></div>
    <a href="{{ path('agent_reservation_show', {id: reservation.id}) }}" class="btn btn-outline btn-sm"><i class="fas fa-arrow-left"></i> Retour</a>
</div>

<div class="detail-card" style="text-align:center;">
    <div style="margin-bottom:24px;">
        <div style="width:80px;height:80px;border-radius:50%;background:linear-gradient(135deg,#8e44ad,#9b59b6);display:flex;align-items:center;justify-content:center;margin:0 auto 16px;font-size:2rem;color:white;">
            📱
        </div>
        <h2 style="font-size:1.4rem;font-weight:800;margin-bottom:8px;">
            QR Code de la Réservation
        </h2>
        <p style="color:var(--text-muted);font-size:0.9rem;">Scannez ce code pour vérifier les détails de la réservation</p>
    </div>

    <!-- QR Code Display -->
    <div style="background:#fff;border:3px dashed #8e44ad;border-radius:20px;padding:30px;display:inline-block;margin-bottom:24px;">
        <img src="{{ qrCode }}" alt="QR Code Réservation #{{ reservation.id }}" style="width:250px;height:250px;display:block;">
    </div>

    <div style="font-size:0.85rem;color:var(--text-muted);margin-bottom:24px;">
        <strong>Réf :</strong> TAHWISSA-RES-{{ reservation.id }}
    </div>

    <!-- Reservation Summary -->
    <div style="background:var(--bg-secondary);border-radius:16px;padding:20px;text-align:left;max-width:500px;margin:0 auto 24px;">
        <h3 style="font-size:1rem;font-weight:700;margin-bottom:12px;color:var(--primary);">📋 Résumé</h3>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;font-size:0.85rem;">
            <div>
                <span style="color:var(--text-muted);">Voyage</span><br>
                <strong>{% if reservation.voyage %}{{ reservation.voyage.titre }}{% else %}N/A{% endif %}</strong>
            </div>
            <div>
                <span style="color:var(--text-muted);">Destination</span><br>
                <strong>{% if reservation.voyage %}{{ reservation.voyage.destination }}{% else %}N/A{% endif %}</strong>
            </div>
            <div>
                <span style="color:var(--text-muted);">Client</span><br>
                <strong>{{ usersById[reservation.idUtilisateur] is defined ? usersById[reservation.idUtilisateur].name : 'Client #' ~ reservation.idUtilisateur }}</strong>
            </div>
            <div>
                <span style="color:var(--text-muted);">Personnes</span><br>
                <strong>{{ reservation.nbrPersonnes }}</strong>
            </div>
            <div>
                <span style="color:var(--text-muted);">Montant</span><br>
                <strong style="color:var(--accent);">{{ reservation.montantTotal|number_format(2, ',', ' ') }} TND</strong>
            </div>
            <div>
                <span style="color:var(--text-muted);">Statut</span><br>
                <span class="badge badge-{{ reservation.statutBadgeClass }}">{{ reservation.statutLabel }}</span>
            </div>
        </div>
    </div>

    <!-- Action Buttons -->
    <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
        <a href="{{ path('agent_reservation_invoice', {id: reservation.id}) }}" class="btn btn-sm" style="background:linear-gradient(135deg,#e74c3c,#c0392b);color:white;border:none;" target="_blank">
            <i class="fas fa-file-pdf"></i> Télécharger la Facture PDF
        </a>
        <a href="{{ qrCode }}" download="qrcode-reservation-{{ reservation.id }}.png" class="btn btn-accent btn-sm">
            <i class="fas fa-download"></i> Télécharger le QR Code
        </a>
        <a href="{{ path('agent_reservation_show', {id: reservation.id}) }}" class="btn btn-outline btn-sm">
            <i class="fas fa-eye"></i> Voir la Réservation
        </a>
    </div>
</div>
{% endblock %}
