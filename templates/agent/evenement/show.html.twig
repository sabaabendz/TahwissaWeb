{% extends 'agent/layout.html.twig' %}
{% block title %}Agent - {{ evenement.titre }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
{% if evenement.hasMapCoordinates %}
{% include 'partials/evenement_map_leaflet_css.html.twig' %}
{% endif %}
{% endblock %}

{% block content %}
<div class="top-bar">
    <div>
        <h1><i class="fas fa-calendar-alt" style="color:var(--primary);margin-right:10px;"></i>Détail Événement</h1>
    </div>
    <div class="top-bar-right">
        <a href="{{ path('agent_evenement_edit', {id: evenement.id}) }}" class="btn btn-primary btn-sm"><i class="fas fa-pen"></i> Modifier</a>
        <a href="{{ path('agent_evenement_index') }}" class="btn btn-outline btn-sm"><i class="fas fa-arrow-left"></i> Retour</a>
    </div>
</div>

<div class="detail-card">
    <div class="detail-header">
        <div>
            <h2 style="font-size:1.6rem;font-weight:800;margin-bottom:8px;">{{ evenement.titre }}</h2>
            <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
                <span class="badge badge-primary"><i class="fas fa-map-marker-alt"></i> {{ evenement.lieu }}</span>
                <span class="badge badge-purple">{{ evenement.categorie ?? 'Non classé' }}</span>
                <span class="badge badge-{{ evenement.statutBadgeClass }}">{{ evenement.statutLabel }}</span>
            </div>
        </div>
        {% include 'partials/evenement_prix_display.html.twig' with { evenement: evenement, variant: 'hero', fontSize: '2rem', sublabel: 'par place' } %}
    </div>

    {% if evenement.description %}
    <div style="margin-bottom:24px;padding:16px;background:#f8fafc;border-radius:var(--radius-sm);color:#475569;font-size:0.92rem;line-height:1.7;">
        {{ evenement.description }}
    </div>
    {% endif %}

    <div class="detail-grid">
        <div class="detail-item">
            <div class="label"><i class="fas fa-calendar-day"></i> Date</div>
            <div class="value">{{ evenement.dateEvent ? evenement.dateEvent|date('d/m/Y') : 'N/A' }}</div>
        </div>
        <div class="detail-item">
            <div class="label"><i class="fas fa-clock"></i> Heure</div>
            <div class="value">{{ evenement.heureEvent ? evenement.heureEvent|date('H:i') : 'N/A' }}</div>
        </div>
        <div class="detail-item">
            <div class="label"><i class="fas fa-chair"></i> Places disponibles</div>
            <div class="value">
                <span class="badge {{ evenement.nbPlaces > 10 ? 'badge-success' : (evenement.nbPlaces > 0 ? 'badge-warning' : 'badge-danger') }}" style="font-size:0.9rem;">
                    {{ evenement.nbPlaces }} places
                </span>
            </div>
        </div>
        <div class="detail-item">
            <div class="label"><i class="fas fa-tag"></i> Catégorie</div>
            <div class="value">{{ evenement.categorie ?? 'Non définie' }}</div>
        </div>
        {% if evenement.hasPromo %}
        <div class="detail-item">
            <div class="label"><i class="fas fa-percent"></i> Promotion</div>
            <div class="value"><span class="badge badge-success">-{{ evenement.promoPercent }}%</span> (prix de base {{ evenement.prix|number_format(2, ',', ' ') }} TND)</div>
        </div>
        {% endif %}
    </div>

    {% include 'partials/evenement_map_section.html.twig' %}

    {# ── Météo prévue ── #}
    {% if evenement.lieu and evenement.dateEvent %}
    <div id="weather-show-widget" style="margin-top:24px;border-radius:12px;overflow:hidden;border:1px solid rgba(90,127,212,.2);background:linear-gradient(135deg,#f0f4ff 0%,#ffffff 100%);">
        <div style="display:flex;align-items:center;gap:.6rem;padding:.75rem 1rem;background:var(--primary,#5a7fd4);color:#fff;font-weight:600;font-size:.85rem;">
            <i class="fas fa-cloud-sun"></i>
            <span>Météo prévue — {{ evenement.lieu }}</span>
        </div>
        <div id="weather-show-body" style="padding:1rem 1.25rem;">
            <div style="display:flex;align-items:center;gap:.6rem;font-size:.85rem;color:var(--text-muted,#888);">
                <i class="fas fa-spinner fa-spin"></i> Chargement de la météo…
            </div>
        </div>
    </div>
    <script>
    (function() {
        const body = document.getElementById('weather-show-body');
        const lieu = {{ evenement.lieu|json_encode|raw }};
        const date = {{ evenement.dateEvent|date('Y-m-d')|json_encode|raw }};
        const url = '/api/weather?lieu=' + encodeURIComponent(lieu) + '&date=' + encodeURIComponent(date);

        fetch(url, {headers:{'Accept':'application/json'}})
            .then(r => r.json())
            .then(data => {
                if (data.error) {
                    body.innerHTML = '<div style="color:#c0392b;font-size:.85rem;"><i class="fas fa-exclamation-circle"></i> ' + data.error + '</div>';
                    return;
                }
                const w = data.weather;
                const d = new Date(w.date + 'T12:00:00');
                const label = d.toLocaleDateString('fr-FR', {day:'numeric',month:'long',year:'numeric'});
                body.innerHTML = `
                    <div style="display:flex;align-items:center;gap:1.2rem;flex-wrap:wrap;">
                        <div style="font-size:2.8rem;color:var(--primary,#5a7fd4);"><i class="fas ${w.icon}"></i></div>
                        <div>
                            <div style="font-size:1.5rem;font-weight:700;color:#1a1a2e;">${Math.round(w.tempMax)}°C <span style="font-size:.95rem;font-weight:400;color:#888;">/ ${Math.round(w.tempMin)}°C</span></div>
                            <div style="font-size:.9rem;color:#888;">${w.description}</div>
                        </div>
                    </div>
                    <div style="display:flex;gap:1.25rem;flex-wrap:wrap;margin-top:.85rem;padding-top:.75rem;border-top:1px solid rgba(90,127,212,.1);font-size:.82rem;color:#888;">
                        <div><i class="fas fa-wind" style="color:var(--primary,#5a7fd4);margin-right:4px;"></i> Vent : <strong>${Math.round(w.windspeed)}</strong> km/h</div>
                        <div><i class="fas fa-tint" style="color:var(--primary,#5a7fd4);margin-right:4px;"></i> Précipitations : <strong>${(w.precipitation||0).toFixed(1)}</strong> mm</div>
                        <div><i class="fas fa-calendar-day" style="color:var(--primary,#5a7fd4);margin-right:4px;"></i> ${label}</div>
                    </div>
                    <div style="margin-top:.6rem;font-size:.72rem;color:#bbb;text-align:right;">Données : <a href="https://open-meteo.com/" target="_blank" style="color:inherit;">Open-Meteo</a></div>
                `;
            })
            .catch(() => {
                body.innerHTML = '<div style="color:#c0392b;font-size:.85rem;"><i class="fas fa-exclamation-circle"></i> Météo indisponible.</div>';
            });
    }());
    </script>
    {% endif %}
</div>
{% endblock %}

{% block javascripts %}
{% if evenement.hasMapCoordinates %}
{% include 'partials/evenement_map_leaflet_js.html.twig' %}
{% endif %}
{% endblock %}
