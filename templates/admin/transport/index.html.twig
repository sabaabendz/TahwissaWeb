{% extends 'admin/layout.html.twig' %}

{% block title %}Gestion Transport{% endblock %}

{% block content %}
<style>
  .transport-card {
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .transport-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 28px rgba(0,0,0,0.15);
  }

  .transport-image {
    width: 100%;
    height: 200px;
    object-fit: cover;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  }

  .transport-content {
    padding: 18px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .transport-header {
    display: flex;
    align-items: center;
    margin-bottom: 12px;
    gap: 10px;
  }

  .transport-type-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    color: white;
    font-size: 1.2rem;
    flex-shrink: 0;
  }

  .type-bus { background: linear-gradient(135deg, #42A5F5, #1565C0); }
  .type-minibus { background: linear-gradient(135deg, #7C4DFF, #B388FF); }
  .type-train { background: linear-gradient(135deg, #00C853, #00E676); }
  .type-plane { background: linear-gradient(135deg, #FF6D00, #FF9100); }
  .type-default { background: linear-gradient(135deg, #666, #999); }

  .transport-title {
    flex: 1;
  }

  .transport-title h3 {
    font-size: 1.05rem;
    font-weight: 700;
    margin: 0;
    color: #1a1a1a;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .transport-title p {
    font-size: 0.8rem;
    color: #888;
    margin: 2px 0 0 0;
  }

  .transport-badge {
    display: inline-block;
    background: #4CAF50;
    color: white;
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .transport-route {
    display: flex;
    align-items: center;
    gap: 6px;
    color: #666;
    font-size: 0.9rem;
    margin-bottom: 12px;
    padding-bottom: 12px;
    border-bottom: 1px solid #f0f0f0;
  }

  .transport-route-item {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .transport-info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-bottom: 14px;
    font-size: 0.85rem;
  }

  .transport-info-item {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #555;
  }

  .transport-info-item i {
    width: 16px;
    color: #4CAF50;
    text-align: center;
  }

  .transport-info-value {
    font-weight: 600;
    color: #222;
  }

  .transport-actions {
    display: flex;
    gap: 8px;
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid #f0f0f0;
  }

  .action-btn {
    flex: 1;
    padding: 8px 12px;
    border: none;
    border-radius: 6px;
    font-size: 0.8rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    transition: all 0.2s;
    text-decoration: none;
    font-weight: 600;
  }

  .action-edit {
    background: #E8F5E9;
    color: #2E7D32;
    border: 1px solid #C8E6C9;
  }

  .action-edit:hover {
    background: #C8E6C9;
  }

  .action-pdf {
    background: #FFEBEE;
    color: #C62828;
    border: 1px solid #FFCDD2;
  }

  .action-pdf:hover {
    background: #FFCDD2;
  }

  .action-delete {
    background: #FFF3E0;
    color: #E65100;
    border: 1px solid #FFE0B2;
  }

  .action-delete:hover {
    background: #FFE0B2;
  }

  .transport-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 20px;
    margin-bottom: 30px;
  }

  .empty-state {
    text-align: center;
    padding: 60px 20px;
    background: white;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
  }

  .empty-icon {
    font-size: 3rem;
    color: #ccc;
    margin-bottom: 16px;
  }

  @media (max-width: 768px) {
    .transport-grid {
      grid-template-columns: 1fr;
    }
    
    .transport-info-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<div class="top-bar">
  <div>
    <h1><i class="fas fa-bus" style="color:var(--secondary);margin-right:10px;"></i>Transport</h1>
    <p style="color:var(--text-muted);font-size:0.9rem;">Gérer les moyens de transport disponibles</p>
  </div>
  <div class="top-bar-right">
    <div class="search-box"><i class="fas fa-search" style="color:var(--text-muted);"></i><input type="text" placeholder="Rechercher..."></div>
    <a href="{{ path('admin_transport_new') }}" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> Ajouter</a>
  </div>
</div>

<!-- Statistics Cards -->
<div class="stats-grid" style="grid-template-columns:repeat(4,1fr);margin-bottom:30px;">
  <div class="stat-card blue">
    <div class="stat-icon"><i class="fas fa-bus"></i></div>
    <div class="stat-info">
      <h3>{{ allTransports|filter(t => t.typeTransport == 'Bus')|length }}</h3>
      <p>Bus</p>
    </div>
  </div>
  <div class="stat-card green">
    <div class="stat-icon"><i class="fas fa-shuttle-van"></i></div>
    <div class="stat-info">
      <h3>{{ allTransports|filter(t => t.typeTransport == 'Minibus')|length }}</h3>
      <p>Minibus</p>
    </div>
  </div>
  <div class="stat-card orange">
    <div class="stat-icon"><i class="fas fa-plane"></i></div>
    <div class="stat-info">
      <h3>{{ allTransports|filter(t => t.typeTransport == 'Avion')|length }}</h3>
      <p>Avion</p>
    </div>
  </div>
  <div class="stat-card purple">
    <div class="stat-icon"><i class="fas fa-train"></i></div>
    <div class="stat-info">
      <h3>{{ allTransports|filter(t => t.typeTransport == 'Train')|length }}</h3>
      <p>Train</p>
    </div>
  </div>
</div>

<!-- Transport Cards Grid -->
{% if transports|length > 0 %}
<div class="transport-grid">
  {% for transport in transports %}
  <div class="transport-card">
    <!-- Image Section -->
    {% if transportImages[transport.getIdTransport()] %}
      <img src="{{ transportImages[transport.getIdTransport()] }}" alt="{{ transport.typeTransport }}" class="transport-image" loading="lazy">
    {% else %}
      <div class="transport-image" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);"></div>
    {% endif %}

    <!-- Content Section -->
    <div class="transport-content">
      <!-- Header with type and status -->
      <div class="transport-header">
        {% set typeClass = transport.typeTransport == 'Bus' ? 'type-bus' : (transport.typeTransport == 'Taxi' ? 'type-minibus' : (transport.typeTransport == 'Train' ? 'type-train' : 'type-default')) %}
        {% set icon = transport.typeTransport == 'Bus' ? 'fas fa-bus' : (transport.typeTransport == 'Taxi' ? 'fas fa-taxi' : 'fas fa-shuttle-van') %}
        <div class="transport-type-badge {{ typeClass }}">
          <i class="{{ icon }}"></i>
        </div>
        <div class="transport-title">
          <h3>{{ transport.typeTransport }}</h3>
          <p>{{ transport.villeDepart }} → {{ transport.villeArrivee }}</p>
        </div>
        <span class="transport-badge">Actif</span>
      </div>

      <!-- Route -->
      <div class="transport-route">
        <div class="transport-route-item">
          <i class="fas fa-map-marker-alt" style="color: #666; font-size: 0.9rem;"></i>
          <span>{{ transport.villeDepart|default('N/A') }}</span>
        </div>
        <div class="transport-route-item" style="margin: 0 4px;">→</div>
        <div class="transport-route-item">
          <i class="fas fa-flag-checkered" style="color: #666; font-size: 0.9rem;"></i>
          <span>{{ transport.villeArrivee|default('N/A') }}</span>
        </div>
      </div>

      <!-- Info Grid -->
      <div class="transport-info-grid">
        <div class="transport-info-item">
          <i class="fas fa-users"></i>
          <span><span class="transport-info-value">{{ transport.nbPlaces }}</span> places</span>
        </div>
        <div class="transport-info-item">
          <i class="fas fa-euro-sign"></i>
          <span><span class="transport-info-value">{{ transport.prix }}</span> TND</span>
        </div>
        <div class="transport-info-item">
          <i class="fas fa-clock"></i>
          <span>{{ transport.duree|default('N/A') }}h</span>
        </div>
        <div class="transport-info-item">
          <i class="fas fa-calendar"></i>
          <span>{{ transport.dateDepart|date('d/m/Y')|default('N/A') }}</span>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="transport-actions">
        <a href="{{ path('admin_transport_edit', {'id': transport.getIdTransport()}) }}" class="action-btn action-edit" title="Modifier">
          <i class="fas fa-pen"></i> Modifier
        </a>
        <a href="{{ path('admin_transport_pdf', {'id': transport.getIdTransport()}) }}" class="action-btn action-pdf" title="Télécharger PDF" target="_blank">
          <i class="fas fa-file-pdf"></i> PDF
        </a>
        <form method="post" action="{{ path('admin_transport_delete', {'id': transport.getIdTransport()}) }}" style="flex: 1;" onsubmit="return confirm('Êtes-vous sûr ?');">
          <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ transport.getIdTransport()) }}">
          <button type="submit" class="action-btn action-delete" title="Supprimer" style="width: 100%;">
            <i class="fas fa-trash"></i> Supprimer
          </button>
        </form>
      </div>
    </div>
  </div>
  {% endfor %}
</div>

{% else %}
<div class="empty-state">
  <div class="empty-icon">
    <i class="fas fa-inbox"></i>
  </div>
  <h3 style="font-size:1.2rem;margin-bottom:8px;color:var(--text-dark);">Aucun transport trouvé</h3>
  <p style="color: #888; margin-bottom: 20px;">Commencez par ajouter un nouveau moyen de transport.</p>
  <a href="{{ path('admin_transport_new') }}" class="btn btn-primary btn-sm">
    <i class="fas fa-plus"></i> Ajouter Transport
  </a>
</div>
{% endif %}

<!-- Pagination -->
{% if transports.pageCount > 1 %}
<div style="display:flex;justify-content:center;align-items:center;margin-top:32px;gap:8px;flex-wrap:wrap;">
  <a href="{{ path('admin_transport_index', {'page': 1}) }}" class="btn btn-outline btn-sm" style="padding:8px 12px;">
    <i class="fas fa-angle-double-left"></i>
  </a>
  
  {% if transports.currentPageNumber > 1 %}
  <a href="{{ path('admin_transport_index', {'page': transports.currentPageNumber - 1}) }}" class="btn btn-outline btn-sm" style="padding:8px 12px;">
    <i class="fas fa-angle-left"></i>
  </a>
  {% else %}
  <span class="btn btn-outline btn-sm" style="padding:8px 12px;opacity:0.5;cursor:not-allowed;">
    <i class="fas fa-angle-left"></i>
  </span>
  {% endif %}

  {% for page in 1..transports.pageCount %}
    {% if page == transports.currentPageNumber %}
      <span class="btn btn-primary btn-sm" style="padding:8px 12px;">{{ page }}</span>
    {% elseif page >= transports.currentPageNumber - 2 and page <= transports.currentPageNumber + 2 %}
      <a href="{{ path('admin_transport_index', {'page': page}) }}" class="btn btn-outline btn-sm" style="padding:8px 12px;">{{ page }}</a>
    {% endif %}
  {% endfor %}

  {% if transports.currentPageNumber < transports.pageCount %}
  <a href="{{ path('admin_transport_index', {'page': transports.currentPageNumber + 1}) }}" class="btn btn-outline btn-sm" style="padding:8px 12px;">
    <i class="fas fa-angle-right"></i>
  </a>
  {% else %}
  <span class="btn btn-outline btn-sm" style="padding:8px 12px;opacity:0.5;cursor:not-allowed;">
    <i class="fas fa-angle-right"></i>
  </span>
  {% endif %}

  <a href="{{ path('admin_transport_index', {'page': transports.pageCount}) }}" class="btn btn-outline btn-sm" style="padding:8px 12px;">
    <i class="fas fa-angle-double-right"></i>
  </a>
</div>
{% endif %}

{% endblock %}
