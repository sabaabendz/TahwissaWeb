{% extends 'admin/layout.html.twig' %}

{% block title %}Tahwissa Admin | Réservations (Transport){% endblock %}

{% block content %}
<div class="top-bar">
    <div>
        <h1><i class="fas fa-ticket-alt" style="color:var(--accent);margin-right:10px;"></i>Réservations (Transport)</h1>
        <p style="color:var(--text-muted);font-size:0.9rem;">Gérer toutes les réservations de transport</p>
    </div>
    <div class="top-bar-right">
        <div class="search-box"><i class="fas fa-search" style="color:var(--text-muted);"></i><input type="text" placeholder="Rechercher..." oninput="filterTable(this.value)"></div>
        <a href="{{ path('admin_reservation_transport_new') }}" class="btn btn-accent btn-sm"><i class="fas fa-plus"></i> Nouvelle</a>
    </div>
</div>

<!-- Stats -->
<div class="stats-grid" style="grid-template-columns:repeat(4,1fr);">
    <div class="stat-card blue"><div class="stat-icon"><i class="fas fa-list"></i></div><div class="stat-info"><h3>{{ allReservations|length }}</h3><p>Total</p></div></div>
    <div class="stat-card green"><div class="stat-icon"><i class="fas fa-check-circle"></i></div><div class="stat-info"><h3>{{ allReservations|filter(r => r.statut == 'CONFIRMEE')|length }}</h3><p>Confirmées</p></div></div>
    <div class="stat-card orange"><div class="stat-icon"><i class="fas fa-clock"></i></div><div class="stat-info"><h3>{{ allReservations|filter(r => r.statut == 'EN_ATTENTE')|length }}</h3><p>En attente</p></div></div>
    <div class="stat-card" style="border-left:4px solid var(--danger);"><div class="stat-icon" style="background:rgba(255,23,68,0.1);color:var(--danger);"><i class="fas fa-times-circle"></i></div><div class="stat-info"><h3>{{ allReservations|filter(r => r.statut == 'ANNULEE')|length }}</h3><p>Annulées</p></div></div>
</div>

<div class="dashboard-card">
    <table class="data-table" id="resTable">
        <thead>
            <tr>
                <th>#</th>
                <th>Client (ID)</th>
                <th>Destination</th>
                <th>Transport</th>
                <th>Date Réserv.</th>
                <th>Voyageurs</th>
                <th>Montant</th>
                <th>Statut</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for r in reservations %}
            <tr>
                <td style="font-weight:600;color:var(--text-muted);">#R{{ '%03d'|format(r.idReservation) }}</td>
                {% set userName = usersById[r.idUser] ?? 'Utilisateur Inconnu' %}
                <td>
                    <div class="user-cell">
                        <div style="width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,#42A5F5,#1565C0);display:flex;align-items:center;justify-content:center;color:white;font-weight:600;font-size:0.8rem;">
                            {{ userName != 'Utilisateur Inconnu' ? userName|slice(0, 2)|upper : 'U' ~ r.idUser }}
                        </div>
                        <div><div class="name">{{ userName }}</div></div>
                    </div>
                </td>
                <td>
                    <i class="fas fa-map-marker-alt" style="color:var(--accent);margin-right:4px;"></i>{{ r.transport.villeArrivee }}
                </td>
                <td>
                    <i class="fas fa-bus" style="color:var(--secondary);margin-right:4px;"></i>{{ r.transport.typeTransport }} ({{ r.transport.villeDepart }})
                </td>
                <td>{{ r.dateReservation|date('d/m/Y') }}</td>
                <td>{{ r.nbPlacesReservees }}</td>
                <td style="font-weight:700;">{{ (r.nbPlacesReservees * r.transport.prix)|number_format(2) }} TND</td>
                <td>
                    {% if r.statut == 'CONFIRMEE' %}<span class="badge badge-success">Confirmée</span>
                    {% elseif r.statut == 'EN_ATTENTE' %}<span class="badge badge-warning">En attente</span>
                    {% elseif r.statut == 'ANNULEE' %}<span class="badge badge-danger">Annulée</span>
                    {% else %}<span class="badge badge-info">{{ r.statut }}</span>
                    {% endif %}
                </td>
                <td>
                    <a href="{{ path('admin_reservation_transport_edit', {'id': r.idReservation}) }}" class="action-btn edit" style="margin-right:5px;"><i class="fas fa-pen"></i></a>
                    <form method="post" action="{{ path('admin_reservation_transport_delete', {'id': r.idReservation}) }}" style="display:inline;" onsubmit="return confirm('Confirmer la suppression ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ r.idReservation) }}">
                        <button type="submit" class="action-btn delete"><i class="fas fa-trash"></i></button>
                    </form>
                </td>
            </tr>
            {% else %}
            <tr><td colspan="9" style="text-align:center;color:#94a3b8;padding:20px;">Aucune réservation trouvée</td></tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<!-- Pagination -->
{% if reservations.pageCount > 1 %}
<div style="display:flex;justify-content:center;align-items:center;margin-top:32px;gap:8px;">
  <a href="{{ path('admin_reservation_transport_index', {'page': 1}) }}" class="btn btn-outline btn-sm" style="padding:8px 12px;">
    <i class="fas fa-angle-double-left"></i>
  </a>
  
  {% if reservations.currentPageNumber > 1 %}
  <a href="{{ path('admin_reservation_transport_index', {'page': reservations.currentPageNumber - 1}) }}" class="btn btn-outline btn-sm" style="padding:8px 12px;">
    <i class="fas fa-angle-left"></i>
  </a>
  {% else %}
  <span class="btn btn-outline btn-sm" style="padding:8px 12px;opacity:0.5;cursor:not-allowed;">
    <i class="fas fa-angle-left"></i>
  </span>
  {% endif %}

  {% for page in 1..reservations.pageCount %}
    {% if page == reservations.currentPageNumber %}
      <span class="btn btn-primary btn-sm" style="padding:8px 12px;">{{ page }}</span>
    {% elseif page >= reservations.currentPageNumber - 2 and page <= reservations.currentPageNumber + 2 %}
      <a href="{{ path('admin_reservation_transport_index', {'page': page}) }}" class="btn btn-outline btn-sm" style="padding:8px 12px;">{{ page }}</a>
    {% endif %}
  {% endfor %}

  {% if reservations.currentPageNumber < reservations.pageCount %}
  <a href="{{ path('admin_reservation_transport_index', {'page': reservations.currentPageNumber + 1}) }}" class="btn btn-outline btn-sm" style="padding:8px 12px;">
    <i class="fas fa-angle-right"></i>
  </a>
  {% else %}
  <span class="btn btn-outline btn-sm" style="padding:8px 12px;opacity:0.5;cursor:not-allowed;">
    <i class="fas fa-angle-right"></i>
  </span>
  {% endif %}

  <a href="{{ path('admin_reservation_transport_index', {'page': reservations.pageCount}) }}" class="btn btn-outline btn-sm" style="padding:8px 12px;">
    <i class="fas fa-angle-double-right"></i>
  </a>
</div>
{% endif %}

<script>
function filterTable(q) {
    document.querySelectorAll('#resTable tbody tr').forEach(r => {
        if(r.cells.length > 1) { // Skip empty state row
            r.style.display = r.textContent.toLowerCase().includes(q.toLowerCase()) ? '' : 'none';
        }
    });
}
</script>
{% endblock %}
