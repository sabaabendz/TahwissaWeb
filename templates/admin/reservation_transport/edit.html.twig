{% extends 'admin/layout.html.twig' %}

{% block title %}Modifier Réservation (Transport){% endblock %}

{% block content %}
<div class="top-bar">
    <div>
        <h1><i class="fas fa-pen" style="color:var(--accent);margin-right:10px;"></i>Modifier Réservation</h1>
        <p style="color:var(--text-muted);font-size:0.9rem;">Mettre à jour la réservation #R{{ '%03d'|format(reservation.idReservation) }}</p>
    </div>
    <div class="top-bar-right">
        <a href="{{ path('admin_reservation_transport_index') }}" class="btn btn-outline btn-sm"><i class="fas fa-arrow-left"></i> Retour</a>
    </div>
</div>

<div class="form-card">
    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
        <div class="form-row">
            <div class="form-group">
                <label for="clientName">Client</label>
                <input type="text" id="clientName" class="form-control" value="{{ userName }}" disabled style="background-color: #f5f5f5; cursor: not-allowed;">
            </div>
            <div class="form-group {{ form_errors(form.transport)|length > 0 ? 'has-error' : '' }}">
                {{ form_label(form.transport) }}
                {{ form_widget(form.transport) }}
                {{ form_errors(form.transport) }}
            </div>
        </div>

        <div class="form-row">
            <div class="form-group {{ form_errors(form.dateReservation)|length > 0 ? 'has-error' : '' }}">
                {{ form_label(form.dateReservation) }}
                {{ form_widget(form.dateReservation) }}
                {{ form_errors(form.dateReservation) }}
            </div>
            <div class="form-group {{ form_errors(form.nbPlacesReservees)|length > 0 ? 'has-error' : '' }}">
                {{ form_label(form.nbPlacesReservees) }}
                {{ form_widget(form.nbPlacesReservees) }}
                {{ form_errors(form.nbPlacesReservees) }}
            </div>
        </div>

        <div class="form-row">
            <div class="form-group {{ form_errors(form.statut)|length > 0 ? 'has-error' : '' }}">
                {{ form_label(form.statut) }}
                {{ form_widget(form.statut) }}
                {{ form_errors(form.statut) }}
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-accent"><i class="fas fa-save"></i> Enregistrer les modifications</button>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
