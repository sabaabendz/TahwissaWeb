<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Réservation Expirée</title>
</head>
<body style="margin:0;padding:0;background:#f4f6f8;font-family:'Segoe UI',Tahoma,Geneva,Verdana,sans-serif;">
    <table width="100%" cellpadding="0" cellspacing="0" style="background:#f4f6f8;padding:32px 0;">
        <tr><td align="center">
            <table width="600" cellpadding="0" cellspacing="0" style="background:white;border-radius:12px;overflow:hidden;box-shadow:0 4px 24px rgba(0,0,0,0.08);">
                <!-- Header -->
                <tr>
                    <td style="background:linear-gradient(135deg,#636e72,#b2bec3);padding:32px;text-align:center;">
                        <h1 style="color:white;margin:0;font-size:24px;">🌍 Tahwissa</h1>
                        <p style="color:rgba(255,255,255,0.85);margin:8px 0 0;font-size:14px;">Agence de Voyages & Tourisme</p>
                    </td>
                </tr>

                <!-- Status Badge -->
                <tr>
                    <td style="padding:24px 32px 0;text-align:center;">
                        <div style="display:inline-block;background:#e2e8f0;color:#475569;padding:8px 24px;border-radius:50px;font-weight:700;font-size:14px;">
                            ⏰ Réservation Expirée
                        </div>
                    </td>
                </tr>

                <!-- Body -->
                <tr>
                    <td style="padding:24px 32px;">
                        <p style="font-size:16px;color:#2d3436;margin:0 0 16px;">Bonjour <strong>{{ clientName }}</strong>,</p>
                        <p style="font-size:14px;color:#636e72;line-height:1.6;margin:0 0 24px;">
                            Votre réservation a <strong>expiré</strong> car elle n'a pas été confirmée dans le délai imparti (30 minutes). Les places ont été remises en disponibilité.
                        </p>

                        <!-- Reservation Details -->
                        <table width="100%" cellpadding="0" cellspacing="0" style="background:#f8f9fa;border-radius:8px;overflow:hidden;margin-bottom:24px;">
                            <tr>
                                <td style="padding:20px;">
                                    <table width="100%" cellpadding="0" cellspacing="0">
                                        <tr>
                                            <td style="padding:6px 0;color:#636e72;font-size:13px;width:140px;">Référence</td>
                                            <td style="padding:6px 0;font-weight:700;color:#2d3436;font-size:13px;">#{{ refId }}</td>
                                        </tr>
                                        <tr>
                                            <td style="padding:6px 0;color:#636e72;font-size:13px;">Voyage</td>
                                            <td style="padding:6px 0;font-weight:700;color:#2d3436;font-size:13px;">{{ voyageTitre }}</td>
                                        </tr>
                                        <tr>
                                            <td style="padding:6px 0;color:#636e72;font-size:13px;">Destination</td>
                                            <td style="padding:6px 0;font-weight:600;color:#636e72;font-size:13px;">📍 {{ destination }}</td>
                                        </tr>
                                        <tr>
                                            <td style="padding:6px 0;color:#636e72;font-size:13px;">Montant</td>
                                            <td style="padding:6px 0;font-weight:700;color:#2d3436;font-size:13px;">{{ montant }} TND</td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>

                        <p style="font-size:13px;color:#636e72;line-height:1.6;margin:0;background:#e3f2fd;padding:12px 16px;border-radius:8px;border-left:4px solid #2196f3;">
                            🔄 Vous pouvez effectuer une nouvelle réservation à tout moment depuis votre espace client si des places sont encore disponibles.
                        </p>
                    </td>
                </tr>

                <!-- Footer -->
                <tr>
                    <td style="background:#f8f9fa;padding:20px 32px;text-align:center;border-top:1px solid #e2e8f0;">
                        <p style="font-size:12px;color:#94a3b8;margin:0;">
                            🌍 Tahwissa — Agence de Voyages & Tourisme, Tunisie<br>
                            À bientôt sur Tahwissa !
                        </p>
                    </td>
                </tr>
            </table>
        </td></tr>
    </table>
</body>
</html>
