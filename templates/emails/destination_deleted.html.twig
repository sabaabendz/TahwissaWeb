{% extends 'emails/base.html.twig' %}

{% block title %}Destination supprimée{% endblock %}

{% block content %}
<h2 style="color: #FF1744;">🗑️ Destination supprimée</h2>
<p>Bonjour,</p>
<p>La destination suivante a été supprimée du catalogue :</p>

<div style="background: #f8d7da; padding: 15px; border-radius: 8px; margin: 15px 0;">
    <h3 style="margin-top: 0; color: #FF1744;">{{ destination.nom }}</h3>
    <p><strong>📍 Pays :</strong> {{ destination.pays }}</p>
</div>

<p>Supprimé le <strong>{{ date|date('d/m/Y à H:i') }}</strong></p>

<p style="color: #FF1744;">⚠️ Cette action est irréversible.</p>
{% endblock %}